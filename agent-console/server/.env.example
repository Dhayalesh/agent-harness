# --- This API ---------------------------------------------------------------
HOST=127.0.0.1
PORT=4000
# Comma separated origins allowed to call this API from a browser.
CORS_ORIGIN=http://localhost:5173

# --- MongoDB ----------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/trueai_agent_platform
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/trueai_agent_platform?retryWrites=true&w=majority
# This is the historical platform database containing agents, model_providers,
# mcp_servers, and skills. The console reads those records in place.
MONGODB_URI=mongodb://127.0.0.1:27017/trueai_agent_platform
# Optional override. If the URI has no database path, the app safely falls back
# to trueai_agent_platform rather than MongoDB's implicit test database.
MONGODB_DB_NAME=

# Provenance stamped on records created through this console.
PLATFORM_CREATED_BY=agent-console

# --- AgentCore Runtime ------------------------------------------------------
# The default way this app runs an agent: bedrock-agentcore:InvokeAgentRuntime
# against a deployed runtime ARN. Set LOCAL_HARNESS_URL below instead to run
# every agent against a harness process on this machine, no ARN or AWS
# credentials needed.
#
# The runtime every stored agent uses. One deployment serves all agents because
# the complete resolved definition travels on each invocation payload.
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/agent_harness-AbCdEf1234

# Endpoint name pointing at a specific version. Unset uses the DEFAULT endpoint.
AGENTCORE_QUALIFIER=

# Left empty, the region is taken from the ARN, which is the region the runtime
# actually lives in. Set it only to override that deliberately.
AWS_REGION=

# Credentials come from the standard AWS chain: environment, SSO cache, shared
# config, or the instance/task role. Name a profile here to pin one.
AWS_PROFILE=

# Milliseconds. AgentCore caps a non-streaming invocation at 15 minutes, so
# anything larger just waits for a request the service has already given up on.
AGENTCORE_TIMEOUT_MS=900000

# --- Generated files (artifacts) -------------------------------------------
# Reuse the harness session bucket. Only the artifact prefix is new. The console
# role needs s3:GetObject on this prefix; do not make the bucket public.
AGENT_SESSION_S3_BUCKET=
AGENT_S3_ARTIFACT_PREFIX=artifacts
AGENT_SESSION_S3_REQUEST_TIMEOUT_MS=10000
AGENT_ARTIFACT_MAX_BYTES=26214400

# --- Chat uploads -----------------------------------------------------------
# Uploaded files are stored in the same bucket under this prefix, which the
# console keeps on a separate allowlist from the artifact prefix so a generated
# file cannot name an upload key or the reverse. Needs s3:PutObject as well as
# s3:GetObject on this prefix.
#
# With no bucket configured, uploads still work: text is extracted on upload and
# the original bytes are kept in MongoDB up to CHAT_UPLOAD_MAX_INLINE_BYTES.
AGENT_S3_UPLOAD_PREFIX=uploads

# Per file, enforced by the multipart parser before anything is buffered.
CHAT_UPLOAD_MAX_FILE_BYTES=26214400
CHAT_UPLOAD_MAX_FILES=10

# Text is what actually reaches the model, so these are the real context cost of
# an upload: per attachment, then across every attachment on one message.
CHAT_UPLOAD_MAX_TEXT_CHARS=200000
CHAT_UPLOAD_MAX_PROMPT_CHARS=600000

# Images are sent to the model as base64, which inflates by a third and has to
# fit this API's 5 MB JSON body and the runtime's 8 MB one.
CHAT_UPLOAD_MAX_IMAGE_BYTES=4194304

# Ceiling for keeping original bytes in MongoDB when no S3 bucket is set. Well
# under the 16 MB BSON document limit. Images ignore this and use the image
# limit above, because their bytes are what the model reads.
CHAT_UPLOAD_MAX_INLINE_BYTES=2097152

# --- Chat titles ------------------------------------------------------------
# Name a new chat from its first exchange, using the agent's own model provider
# in one small non-streaming request. Set false to keep the placeholder name.
# Turning it off does not disable the prompt-derived fallback, which always runs
# and is also what a failed or slow request degrades to.
CHAT_AUTO_TITLE=true
CHAT_TITLE_TIMEOUT_MS=8000
CHAT_TITLE_MAX_LENGTH=60

# Exact local tools offered by the deployed image. The default matches the
# Linux harness without optional Tavily search. Add web_search only when the
# runtime has TAVILY_API_KEY; PowerShell is disabled in the supplied image.
#
# The response file tools (create_markdown_artifact, create_json_artifact,
# create_code_artifact, and the rest) are deliberately absent: the runtime always
# offers them regardless of an agent's tool list, so they are not selectable here.
AGENT_RUNTIME_TOOLS=read_file,glob,grep,write_file,edit_file,bash,todo_write,web_fetch

# --- Local harness (optional, no AWS at all) --------------------------------
# Set this to switch every agent from AgentCore to a plain HTTP call against a
# harness process on this machine (`npm start` in agent-harness-clone). It wins
# over AGENTCORE_RUNTIME_ARN unconditionally when set. Leave empty to use
# AgentCore as above; nothing else changes when this is unset.
LOCAL_HARNESS_URL=

# Sent as x-agent-service-key when the harness has AGENT_SERVICE_KEY set.
# Leave empty for a harness running unauthenticated on loopback.
LOCAL_HARNESS_SERVICE_KEY=

# Milliseconds. Same reasoning as AGENTCORE_TIMEOUT_MS, for the local harness.
LOCAL_HARNESS_TIMEOUT_MS=900000


# --- This API ---------------------------------------------------------------
HOST=127.0.0.1
PORT=4000
# Comma separated origins allowed to call this API from a browser.
CORS_ORIGIN=http://localhost:5173

# --- MongoDB ----------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/trueai_agent_platform
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/trueai_agent_platform?retryWrites=true&w=majority
# This is the historical platform database containing agents, model_providers,
# mcp_servers, and skills. The console reads those records in place.
MONGODB_URI=mongodb://127.0.0.1:27017/trueai_agent_platform
# Optional override. If the URI has no database path, the app safely falls back
# to trueai_agent_platform rather than MongoDB's implicit test database.
MONGODB_DB_NAME=

# Provenance stamped on records created through this console.
PLATFORM_CREATED_BY=agent-console

# --- AgentCore Runtime ------------------------------------------------------
# The only way this app runs an agent: bedrock-agentcore:InvokeAgentRuntime
# against a deployed runtime ARN. There is no local transport.
#
# The runtime every stored agent uses. One deployment serves all agents because
# the complete resolved definition travels on each invocation payload.
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/agent_harness-AbCdEf1234

# Endpoint name pointing at a specific version. Unset uses the DEFAULT endpoint.
AGENTCORE_QUALIFIER=

# Left empty, the region is taken from the ARN, which is the region the runtime
# actually lives in. Set it only to override that deliberately.
AWS_REGION=

# Credentials come from the standard AWS chain: environment, SSO cache, shared
# config, or the instance/task role. Name a profile here to pin one.
AWS_PROFILE=

# Milliseconds. AgentCore caps a non-streaming invocation at 15 minutes, so
# anything larger just waits for a request the service has already given up on.
AGENTCORE_TIMEOUT_MS=900000

# Exact local tools offered by the deployed image. The default matches the
# Linux harness without optional Tavily search. Add web_search only when the
# runtime has TAVILY_API_KEY; PowerShell is disabled in the supplied image.
AGENT_RUNTIME_TOOLS=read_file,glob,grep,write_file,edit_file,bash,todo_write,web_fetch


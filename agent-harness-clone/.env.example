# Nothing here configures an agent.
#
# The model, its credential, the system prompt, the tools, the MCP servers, and the
# skills all arrive on the invocation payload. What the environment sets is where the
# process listens and what it will allow a payload to do. Every variable is optional
# and the defaults are the ones the container ships with.

# Runtime, invocation, payload, model, MCP, tool, and permission lifecycle records are
# always written as redacted JSON lines. They go to stdout AND to a CloudWatch log
# group this deployment owns, laid out one stream per session:
#
#   agentcore / YYYY/MM/DD/<sessionId>
#
# That is the grouping an operator reads by. Without it the only streams are the ones
# AgentCore names itself — <date>/[runtime-logs]<runtime session id>, in a group it
# also chooses — which are findable only if you already know the runtime session id.
#
# The task role needs logs:CreateLogGroup, logs:CreateLogStream, and logs:PutLogEvents
# on this group. The group is created on first write if it does not exist.
#
# Delivery is batched and retried; if CloudWatch stays unavailable the oldest queued
# lines are dropped and a cloudwatch.events.dropped record naming the count is written
# to stderr, so a gap is always visible rather than silent.
#
# Rename the group here. Set it to "-" to write to stdout only, which is what a
# developer running this without AWS credentials wants.
AGENT_LOG_GROUP=agentcore

# Region for the writer above. Falls back to the SDK's own resolution when unset,
# which in a deployed container is what the task role already provides.
AWS_REGION=

# One run's logs are one stream. Pass the same runtimeSessionId on
# invoke_agent_runtime, or the same sessionId in the payload, and every invocation of
# that run lands in one stream with the same sessionId on every line. Omit both and
# each call is its own session, and so its own stream.

# Where the listener binds. The AgentCore Runtime contract fixes these two.
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8080

# Required in the x-agent-service-key header when set. Leave unset ONLY behind a front
# door that authenticates for you: a payload chooses the system prompt, the model
# endpoint, the MCP servers, and the permission mode, so an open port is remote code
# execution. The process warns on stderr at startup when this is empty.
AGENT_SERVICE_KEY=

# Parent of the per-invocation workspace. Each run gets its own directory beneath it.
AGENT_WORKSPACE=

# Caps what any payload may ask for, regardless of its own permissionMode.
#   plan  - refuse every state-changing tool
#   deny  - refuse every tool
#   none  - the payload decides, including bypass (default)
AGENT_PERMISSION_CEILING=none

# Names this deployment's tools need beyond the allowlist, comma separated. Everything
# else in the process environment is withheld from spawned commands.
AGENT_SHELL_ENV_ALLOWLIST=

# Backend for the web_search tool. Unset simply omits that one tool from the catalogue.
TAVILY_API_KEY=

# Only scripts/headless/exportPayload.ts reads this, and only to convert agents stored
# by a previous version into payload files. The runtime never opens a database.
PLATFORM_MONGODB_URI=

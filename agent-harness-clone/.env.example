# Nothing here configures an agent.
#
# The model, its credential, the system prompt, the tools, the MCP servers, and each
# skill's S3 URI arrive on the invocation payload. Skill bodies do not: the runtime
# downloads them with the host's ambient AWS SDK credentials. What the environment
# sets is where the process listens, which AWS region it uses, and what it will allow
# a payload to do. Every variable below is optional when its feature is unused.

# Runtime, invocation, model, skill, MCP, tool, permission, output, and cleanup
# lifecycle milestones are written as concise JSON lines at info level. Set the level
# to debug temporarily to include redacted payload/model/tool/MCP details and protocol
# deltas. Logs go to stdout AND to a CloudWatch log group this deployment owns, laid
# out one stream per session:
#
#   agentcore / YYYY/MM/DD/<sessionId>
#
# That is the grouping an operator reads by. Without it the only streams are the ones
# AgentCore names itself — <date>/[runtime-logs]<runtime session id>, in a group it
# also chooses — which are findable only if you already know the runtime session id.
#
# The task role needs logs:CreateLogGroup, logs:CreateLogStream, and logs:PutLogEvents
# on this group. The group is created on first write if it does not exist.
#
# Delivery is batched and retried; if CloudWatch stays unavailable the oldest queued
# lines are dropped and a cloudwatch.events.dropped record naming the count is written
# to stderr, so a gap is always visible rather than silent.
#
# Rename the group here. Set it to "-" to write to stdout only. This disables direct
# CloudWatch delivery, but an invocation with S3 skills still needs AWS credentials.
AGENT_LOG_GROUP=agentcore

# Minimum JSON log level: debug, info, warn, or error. Defaults to info.
AGENT_LOG_LEVEL=info

# Region for the CloudWatch writer above and S3 skill GetObject calls. When unset, the
# SDK uses its normal region resolution. Credentials also use the standard SDK chain:
# attach an AgentCore execution role in deployment, or use the normal AWS environment,
# shared config, or profile locally. Do not put S3 credentials in an invocation.
AWS_REGION=

# The execution role needs s3:GetObject only for the buckets/prefixes that may contain
# skills. A payload caller chooses the URI, so IAM scope is what prevents reads outside
# approved locations. The runtime does not need s3:PutObject for skill materialization.

# One run's logs are one stream. Pass the same runtimeSessionId on
# invoke_agent_runtime, or the same sessionId in the payload, and every invocation of
# that run lands in one stream with the same sessionId on every line. Omit both and
# each call is its own session, and so its own stream.

# Conversation persistence. `s3` uses S3 as the durable source of truth and this
# directory as a warm atomic-file cache. Keep `file` until the bucket below is filled.
# `memory` is test-only; `none` makes every invocation stateless.
AGENT_SESSION_STORE=file
AGENT_SESSION_DIR=/tmp/agent-harness-sessions
# SAP-oriented local cache: eight idle hours and at most 25 MiB per session.
AGENT_SESSION_TTL_SECONDS=28800
AGENT_SESSION_MAX_BYTES=26214400

# Required only when AGENT_SESSION_STORE=s3. The execution role supplies credentials;
# never put access keys here. Objects are written under <prefix>/<sessionId>.json with
# conditional writes and S3-managed server-side encryption (SSE-S3).
AGENT_SESSION_S3_BUCKET=
AGENT_SESSION_S3_PREFIX=sessions
AGENT_S3_ARTIFACT_PREFIX=artifacts
AGENT_SESSION_S3_REQUEST_TIMEOUT_MS=10000
AGENT_ARTIFACT_MAX_BYTES=26214400

# Generated Markdown, HTML, DOCX, XLSX, and CSV artifacts reuse
# AGENT_SESSION_S3_BUCKET and are separated by
# AGENT_S3_ARTIFACT_PREFIX. The runtime role needs s3:PutObject on that prefix.
# Local development falls back to this directory when the shared bucket is unset;
# the console keeps its legacy MongoDB byte copy so preview/download still work.
AGENT_ARTIFACT_DIR=/tmp/agent-harness-artifacts

# Where the listener binds. The AgentCore Runtime contract fixes these two.
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8080

# Required in the x-agent-service-key header when set. Leave unset ONLY behind a front
# door that authenticates for you: a payload chooses the system prompt, the model
# endpoint, the MCP servers, and the permission mode, so an open port is remote code
# execution. The process warns on stderr at startup when this is empty.
AGENT_SERVICE_KEY=

# Parent of the per-invocation workspace. Each run gets its own directory beneath it.
AGENT_WORKSPACE=

# Caps what any payload may ask for, regardless of its own permissionMode.
#   plan  - refuse every state-changing tool
#   deny  - refuse every tool
#   none  - the payload decides, including bypass (default)
AGENT_PERMISSION_CEILING=none

# Names this deployment's tools need beyond the allowlist, comma separated. Everything
# else in the process environment is withheld from spawned commands.
AGENT_SHELL_ENV_ALLOWLIST=

# Backend for the web_search tool. Unset simply omits that one tool from the catalogue.
TAVILY_API_KEY=

# Only scripts/headless/exportPayload.ts reads this, and only to convert agents stored
# by a previous version into payload files. The runtime never opens a database.
PLATFORM_MONGODB_URI=

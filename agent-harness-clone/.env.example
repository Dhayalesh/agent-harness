# Nothing here configures an agent.
#
# The model, its credential, the system prompt, the tools, the MCP servers, and the
# skills all arrive on the invocation payload. What the environment sets is where the
# process listens and what it will allow a payload to do. Every variable is optional
# and the defaults are the ones the container ships with.

# Runtime, invocation, model, MCP, and tool lifecycle logs are always written as
# redacted JSON lines to stdout. AgentCore forwards that stream to CloudWatch; no AWS
# logging credential or application-side CloudWatch configuration is required here.

# Where the listener binds. The AgentCore Runtime contract fixes these two.
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8080

# Required in the x-agent-service-key header when set. Leave unset ONLY behind a front
# door that authenticates for you: a payload chooses the system prompt, the model
# endpoint, the MCP servers, and the permission mode, so an open port is remote code
# execution. The process warns on stderr at startup when this is empty.
AGENT_SERVICE_KEY=

# Parent of the per-invocation workspace. Each run gets its own directory beneath it.
AGENT_WORKSPACE=

# Caps what any payload may ask for, regardless of its own permissionMode.
#   plan  - refuse every state-changing tool
#   deny  - refuse every tool
#   none  - the payload decides, including bypass (default)
AGENT_PERMISSION_CEILING=none

# Names this deployment's tools need beyond the allowlist, comma separated. Everything
# else in the process environment is withheld from spawned commands.
AGENT_SHELL_ENV_ALLOWLIST=

# Backend for the web_search tool. Unset simply omits that one tool from the catalogue.
TAVILY_API_KEY=

# Only scripts/headless/exportPayload.ts reads this, and only to convert agents stored
# by a previous version into payload files. The runtime never opens a database.
PLATFORM_MONGODB_URI=

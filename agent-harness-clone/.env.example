# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Loaded automatically by the agent, service, platform, and test scripts.
# Everything not listed here has a working default in code.

# Required for any live run. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter slug from https://openrouter.ai/models — must support tool calling.
# Defaults to anthropic/claude-sonnet-4.6 when unset.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Output cap per model call. Defaults to 8192; OpenRouter returns HTTP 402 when
# your balance cannot cover that many tokens. Lower it to fit your credits.
AGENT_MAX_OUTPUT_TOKENS=1024

# Model calls allowed per run before the session stops with MAX_TURNS_REACHED.
# Defaults to 24. Each turn is one OpenRouter request, so raising this consumes
# more of the free-tier daily request quota.
AGENT_MAX_TURNS=24

# Optional persona/instructions for `npm run agent`. The CLI has no built-in
# prompt: unset means the model runs on its own defaults plus tool descriptions.
# AGENT_SYSTEM_PROMPT wins over AGENT_SYSTEM_PROMPT_FILE when both are set.
AGENT_SYSTEM_PROMPT=
AGENT_SYSTEM_PROMPT_FILE=

# Only for `npm run service`: `demo` (no credential) or `openrouter`.
AGENT_PROVIDER=openrouter

# Enables the web_search tool. Get a key at https://app.tavily.com
# Without it web_search is not registered; web_fetch needs no credential.
TAVILY_API_KEY=

# Only for `npm run platform`.
MONGODB_URI=mongodb://127.0.0.1:27017
PLATFORM_BOOTSTRAP_API_KEY=
PLATFORM_SECRET_DEFAULT__OPENROUTER_API_KEY=
